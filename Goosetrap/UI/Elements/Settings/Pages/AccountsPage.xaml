<ui:UiPage x:Class="Goosetrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Goosetrap.Resources"
      xmlns:local="clr-namespace:Goosetrap.UI.ViewModels.Settings"
      xmlns:converters="clr-namespace:Goosetrap.UI.Converters"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="{x:Static resources:Strings.Menu_Accounts_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ui:CardAction Margin="0,0,0,16" Icon="Add24" Command="{Binding AddAccountCommand}">
            <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_AddAccount}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </ui:CardAction>

        <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_SavedAccounts}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Empty state -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="24" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,16" 
                Visibility="{Binding Accounts.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="People28" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_NoAccounts}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_NoAccountsSub}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Accounts Grid -->
        <ItemsControl ItemsSource="{Binding Accounts}" Visibility="{Binding Accounts.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=Invert}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:AccountUIModel}">
                    <!-- Account Card -->
                    <Border Width="200" Height="285" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Margin="0,0,12,12"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Avatar & Online status -->
                                <RowDefinition Height="Auto" /> <!-- Names & ID -->
                                <RowDefinition Height="Auto" /> <!-- Metrics (RAM, etc) -->
                                <RowDefinition Height="*" />    <!-- Spacer -->
                                <RowDefinition Height="Auto" /> <!-- Action buttons & Launch button -->
                            </Grid.RowDefinitions>

                            <!-- Circular Avatar Headshot -->
                            <Grid Grid.Row="0" Margin="0,8,0,12">
                                <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarUri, FallbackValue='pack://application:,,,/Goosetrap.png'}" />
                                    </Border.Background>
                                </Border>
                                <!-- Green dot for active running status -->
                                <Border Width="16" Height="16" Background="#8AE639" CornerRadius="8" 
                                        BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="52,0,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- User Info -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UserId, StringFormat='ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Running Process Metrics -->
                            <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Database20" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RamUsage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Buttons (Launch & Settings icons) -->
                            <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Command="{Binding OpenProfileCommand}" Appearance="Transparent" ToolTip="{x:Static resources:Strings.Menu_Accounts_TooltipProfile}" HorizontalAlignment="Center" Padding="8,6">
                                         <ui:SymbolIcon Symbol="Info24" FontSize="16" />
                                     </ui:Button>
                                     <ui:Button Grid.Column="1" Command="{Binding EditCommand}" CommandParameter="{Binding}" Appearance="Transparent" ToolTip="{x:Static resources:Strings.Menu_Accounts_TooltipEdit}" HorizontalAlignment="Center" Padding="8,6">
                                         <ui:SymbolIcon Symbol="Edit24" FontSize="16" />
                                     </ui:Button>
                                     <ui:Button Grid.Column="2" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" Appearance="Transparent" ToolTip="{x:Static resources:Strings.Menu_Accounts_TooltipDelete}" HorizontalAlignment="Center" Padding="8,6" Foreground="#FF5C5C">
                                         <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                     </ui:Button>
                                </Grid>
                                
                                <ui:Button Content="{x:Static resources:Strings.Menu_Accounts_Launch}" Command="{Binding LaunchCommand}" Icon="Play24" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
