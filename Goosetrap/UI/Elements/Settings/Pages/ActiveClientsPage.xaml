<ui:UiPage x:Class="Goosetrap.UI.Elements.Settings.Pages.ActiveClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Goosetrap.Resources"
      xmlns:local="clr-namespace:Goosetrap.UI.ViewModels.Settings"
      xmlns:converters="clr-namespace:Goosetrap.UI.Converters"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ActiveClientsPage"
      Scrollable="True">
    
    <ui:UiPage.Resources>
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
    </ui:UiPage.Resources>
    
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="{x:Static resources:Strings.Menu_ActiveClients_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ui:CardAction Margin="0,0,0,16" Icon="ArrowClockwise24" Command="{Binding RefreshCommand}">
            <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_RefreshBtn}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </ui:CardAction>

        <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_RunningClients}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Empty state -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="24" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,16" 
                Visibility="{Binding Clients.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="Нет запущенных окон Roblox" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Process List -->
        <ListView ItemsSource="{Binding Clients}" BorderThickness="0" Background="Transparent"
                  Visibility="{Binding Clients.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=Invert}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="16,12" 
                                        Margin="0,0,0,12">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type local:RobloxClientInfo}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <ui:SymbolIcon Symbol="Person24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center" Grid.Column="0">
                            <ui:SymbolIcon.Foreground>
                                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                            </ui:SymbolIcon.Foreground>
                        </ui:SymbolIcon>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_AccountLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text=" (" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                                <TextBlock Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_GameLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_ProcessIDLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding Pid}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,12,0" />

                                <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_MemoryLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding RamUsage}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,12,0" />

                                <TextBlock Text="{x:Static resources:Strings.Menu_ActiveClients_UptimeLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding Uptime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Grid.Column="3" VerticalAlignment="Center">
                            <ui:Button Content="{x:Static resources:Strings.Menu_ActiveClients_RestartBtn}" 
                                       Appearance="Primary" 
                                       Icon="ArrowCounterclockwise24" 
                                       Command="{Binding ReconnectCommand}" 
                                       Margin="0,0,8,0" 
                                       Padding="12,8" />
                            <ui:Button Content="{x:Static resources:Strings.Menu_ActiveClients_CloseBtn}" 
                                       Appearance="Secondary" 
                                       Icon="Dismiss24" 
                                       Command="{Binding KillCommand}" 
                                       Padding="12,8" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ui:UiPage>
